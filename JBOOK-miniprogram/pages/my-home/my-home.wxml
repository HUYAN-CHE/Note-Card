<view class="page my-home-page">
  <!-- 固定渐变背景层：页面滚动时背景不动 -->
  <view class="page-bg"></view>

  <custom-nav title="我的主页" showBack="{{true}}" statusBarHeight="{{statusBarHeight}}" navHeight="{{navHeight}}" />

  <!-- 用户区：昵称 + 技能 -->
  <view class="user-area" style="padding-top: {{heroPaddingTop}}px;">
      <view class="user-row">
        <text class="nickname">{{user.nickname || '点击授权'}}</text>
        <view class="user-arrow" bindtap="onLogoutTap" aria-label="退出登录">
          <image class="user-arrow-icon" src="/assets/icons/logout-green.svg" mode="aspectFit" />
        </view>
      </view>
      <view class="skill-row">
        <view class="skill-tags" wx:if="{{serviceTags.length}}">
          <view class="tag-pill {{tagEditing ? 'editing' : ''}}" wx:for="{{serviceTags}}" wx:key="*this">
            <text class="tag-text">{{item}}</text>
            <text class="tag-remove" wx:if="{{tagEditing}}" bindtap="removeTag" data-index="{{index}}">×</text>
          </view>
        </view>
        <text class="skill-hint" wx:else>暂未绑定技能</text>
      <view class="skill-edit-btn" bindtap="toggleTagEdit">{{tagEditing ? '完成' : '编辑技能'}}</view>
      </view>

      <!-- 技能编辑区 -->
      <view class="tag-edit-area" wx:if="{{tagEditing}}">
        <input
          class="tag-input"
          value="{{tagInput}}"
          bindinput="onTagInput"
          bindconfirm="addTag"
          placeholder="输入标签，按回车添加"
          confirm-type="done"
        />
        <view class="candidate-tags" wx:if="{{candidateTags.length}}">
          <text class="candidate-label">推荐：</text>
          <text
            class="candidate-tag"
            wx:for="{{candidateTags}}"
            wx:key="*this"
            bindtap="addCandidateTag"
            data-tag="{{item}}"
          >{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 会员卡：按会员状态展示，点击进会员页 -->
    <view class="member-card" bindtap="onMemberTap">
      <image class="member-icon" src="/assets/images/icon-crown.svg" mode="aspectFit" />
      <view class="member-text">
        <block wx:if="{{memberStatus === 'active'}}">
          <text class="member-title">会员有效期至 {{memberExpireText}}</text>
          <text class="member-desc">还剩 {{memberDaysLeft}} 天 · 聊天创建 / 灵感集采 / 多端同步</text>
        </block>
        <block wx:elif="{{memberStatus === 'expired'}}">
          <text class="member-title">会员已过期</text>
          <text class="member-desc">续费后恢复全部会员权益</text>
        </block>
        <block wx:else>
          <text class="member-title">会员专享：</text>
          <text class="member-desc">聊天创建 / 灵感集采 / 多端同步...</text>
        </block>
      </view>
      <view class="member-btn">{{memberStatus === 'active' ? '查看' : (memberStatus === 'expired' ? '立即续费' : '立即开通')}}</view>
    </view>

    <!-- 我的灵感卡 -->
    <view class="section card section-inspire">
      <view class="section-header">
        <view class="section-title-wrap">
          <image class="section-icon" src="/assets/icons/icon-sparkle.svg" mode="aspectFit" />
          <text class="section-title">我的灵感卡</text>
        </view>
        <view class="inspire-tabs">
          <text
            class="inspire-tab {{inspireTab === 'collecting' ? 'active' : ''}}"
            bindtap="switchInspireTab"
            data-tab="collecting"
          >集灵中 {{inspireCards.length}}</text>
          <text
            class="inspire-tab {{inspireTab === 'exported' ? 'active' : ''}}"
            bindtap="switchInspireTab"
            data-tab="exported"
          >已输出 {{exportedCards.length}}</text>
        </view>
      </view>

      <!-- 集灵中：横滑最多 5 个 + 查看全部 -->
      <view class="inspire-scroll-wrap" wx:if="{{inspireTab === 'collecting'}}">
        <scroll-view class="inspire-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{previewCards.length}}">
          <view class="inspire-row">
            <view class="inspire-card" wx:for="{{previewCards}}" wx:key="id" bindtap="openInspireDetail" data-id="{{item.id}}" data-color="{{item.color}}">
              <view class="inspire-card-top" style="background: {{item.color}};">
                <view class="inspire-card-title">{{item.title}}</view>
                <view class="inspire-card-desc">{{item.desc}}</view>
                <view class="inspire-tags">
                  <text class="inspire-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                </view>
              </view>
              <view class="inspire-card-foot">
                <text class="inspire-explore">查看</text>
                <view class="inspire-arrow">→</view>
              </view>
            </view>
            <view class="inspire-more" wx:if="{{inspireCards.length > 5}}" bindtap="openInspireList">
              <text class="inspire-more-text">查看全部</text>
              <text class="inspire-more-arrow">→</text>
            </view>
          </view>
        </scroll-view>
        <!-- 右缘渐变遮罩：卡片滑到边缘渐隐 -->
        <view class="inspire-edge-fade" wx:if="{{previewCards.length}}"></view>
        <empty-state wx:if="{{!previewCards.length}}" title="还没有集灵中的灵感卡" subtitle="去企业微信找灵感 Bot，记录第一条零碎灵感" mode="simple" />
      </view>

      <!-- 已输出：横滑卡片，与集灵中同样式 -->
      <view class="inspire-scroll-wrap" wx:else>
        <scroll-view class="inspire-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{exportedCards.length}}">
          <view class="inspire-row">
            <view class="inspire-card" wx:for="{{exportedCards}}" wx:key="id" bindtap="openInspireDetail" data-id="{{item.id}}" data-color="{{item.color}}">
              <view class="inspire-card-top" style="background: {{item.color}};">
                <view class="inspire-card-title">{{item.title}}</view>
                <view class="inspire-card-desc">{{item.desc}}</view>
                <view class="inspire-tags">
                  <text class="inspire-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                </view>
              </view>
              <view class="inspire-card-foot">
                <text class="inspire-explore">查看</text>
                <view class="inspire-arrow">→</view>
              </view>
            </view>
          </view>
        </scroll-view>
        <view class="inspire-edge-fade" wx:if="{{exportedCards.length}}"></view>
        <empty-state wx:if="{{!exportedCards.length}}" title="还没有已输出的灵感卡" mode="simple" />
      </view>
    </view>

    <!-- 我的记事卡 -->
    <view class="section card section-last">
      <view class="section-header">
        <view class="section-title-wrap">
          <image class="section-icon" src="/assets/icons/icon-pencil-solid.svg" mode="aspectFit" />
          <text class="section-title">我的记事卡</text>
        </view>
      </view>
      <view class="subtabs">
        <view
          class="subtab {{activeTab === 'pending' ? 'on' : ''}}"
          bindtap="switchTab"
          data-tab="pending"
        >待确定 {{counts.pending}}</view>
        <view
          class="subtab {{activeTab === 'doing' ? 'on' : ''}}"
          bindtap="switchTab"
          data-tab="doing"
        >进行中 {{counts.doing}}</view>
        <view
          class="subtab {{activeTab === 'done' ? 'on' : ''}}"
          bindtap="switchTab"
          data-tab="done"
        >已完成 {{counts.done}}</view>
        <view
          class="subtab {{activeTab === 'helped' ? 'on' : ''}}"
          bindtap="switchTab"
          data-tab="helped"
        >协助的事 {{counts.helped}}</view>
      </view>

      <!-- 容器固定 5 张卡高度，多于 5 个区块内滑动 -->
      <scroll-view
        wx:if="{{cards.length}}"
        class="card-scroll"
        scroll-y="{{cards.length > 5}}"
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="card-list">
          <view
            wx:for="{{cards}}"
            wx:key="id"
            class="card-item"
            bindtap="openCard"
            data-id="{{item.id}}"
          >
            <view class="card-icon">{{item.icon}}</view>
            <view class="card-info">
              <text class="card-title">{{item.displayTitle}}</text>
              <text class="card-meta">截止日期 {{item.deadlineText}}</text>
            </view>
            <view class="card-status {{item.statusClass}}" aria-hidden="true">
              <text class="status-text">{{item.statusText}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 无卡：普通空态，此区域滑动 = 滚动页面 -->
      <view class="card-empty-wrap" wx:elif="{{!loading}}">
        <empty-state title="{{emptyText}}" mode="simple" />
      </view>
    </view>
</view>
