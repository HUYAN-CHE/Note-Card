/* 页面可整体滚动；自身背景透明，只用固定渐变层，避免双层错位 */
.my-home-page {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding: 0 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: transparent;
}

/* 固定渐变背景层：与全局 .page 同款渐变，页面滚动时背景不动；z-index:-1 沉到内容之下 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(246, 240, 228, 0.5) 58%, rgba(246, 240, 228, 0.88) 100%),
    linear-gradient(155deg, #d9f6fb 0%, #d9f4df 44%, #f7f1e4 100%);
}

/* 用户区：昵称 + 技能 */
.user-area {
  padding: 0 8rpx;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nickname {
  font-size: 48rpx;
  font-weight: 800;
  color: #162116;
}

.user-arrow {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(22, 163, 74, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-arrow-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 账号弹窗内容（bottom-sheet 内）：主操作绿胶囊 + 次级灰底行 */
.account-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.sheet-btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  margin: 0;
}

.sheet-btn::after {
  display: none;
}

.sheet-btn.primary {
  color: #fff;
  background: #4caf50;
}

.sheet-btn.ghost {
  color: #666;
  background: #f0f0f0;
}

.account-danger {
  color: #e53935;
}

.skill-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 20rpx;
}

.skill-hint {
  font-size: 26rpx;
  color: #9aa79c;
}

.skill-tags {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-edit-btn {
  flex-shrink: 0;
  margin-left: auto;
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #16a34a;
  border-radius: 28rpx;
  font-weight: 500;
  background: rgba(22, 163, 74, 0.05);
}

/* 技能编辑区 */
.tag-edit-area {
  margin-top: 20rpx;
}

.tag-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #333;
}

.candidate-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
}

.candidate-label {
  font-size: 24rpx;
  color: #999;
}

.candidate-tag {
  padding: 8rpx 20rpx;
  background: #f5f7fa;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #4caf50;
  border: 1rpx solid #e8f5e9;
}

/* 会员卡：会员购买提示（同会员模块 vip-banner 内容） */
.member-card {
  display: flex;
  align-items: center;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #a3e635 0%, #6fcf1f 100%);
  box-shadow: 0 8rpx 24rpx rgba(124, 196, 30, 0.2);
}

.member-icon {
  width: 44rpx;
  height: 44rpx;
  flex: none;
}

.member-text {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-left: 16rpx;
  white-space: nowrap;
  overflow: hidden;
}

.member-title {
  flex: none;
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
}

.member-desc {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  background: #ffffff;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #16a34a;
}

/* 区块容器：间距由页面 gap 统一控制 */
.my-home-page .section {
  margin-top: 0;
  padding: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title-wrap .section-title {
  margin-bottom: 0;
  font-size: 30rpx;
}

.section-icon {
  width: 40rpx;
  height: 40rpx;
}

/* 灵感卡 tab：集灵中 / 已输出（分段控件：灰槽 + 选中白色凸起） */
.inspire-tabs {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f0f1f0;
}

.inspire-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #9aa79c;
}

.inspire-tab.active {
  color: #16a34a;
  background: #ffffff;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(22, 33, 22, 0.08);
}

/* 灵感卡横向滑动（取自首页 inspire-card） */
.inspire-scroll-wrap {
  position: relative;
}

.inspire-scroll {
  width: 100%;
  white-space: nowrap;
}

.inspire-row {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.inspire-card {
  flex-shrink: 0;
  width: 440rpx;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(28, 28, 30, 0.05);
}

.inspire-card-top {
  padding: 32rpx 32rpx 36rpx;
  box-sizing: border-box;
}

.inspire-card-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1c1c1e;
  line-height: 1.35;
}

.inspire-card-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: rgba(28, 28, 30, 0.5);
  line-height: 1.6;
  white-space: normal;
}

.inspire-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 28rpx;
}

.inspire-tag {
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(28, 28, 30, 0.55);
  line-height: 1;
}

.inspire-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.inspire-explore {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 28, 30, 0.45);
}

.inspire-arrow {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(28, 28, 30, 0.5);
}

/* 查看全部卡：总数超过 5 时出现在横滑末尾（极浅灰底） */
.inspire-more {
  flex-shrink: 0;
  width: 200rpx;
  border-radius: 24rpx;
  background: #f4f5f6;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.inspire-more-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #68705f;
}

.inspire-more-arrow {
  font-size: 32rpx;
  color: #16a34a;
}

/* 右缘渐变遮罩：卡片滑到边缘渐隐 */
.inspire-edge-fade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 64rpx;
  pointer-events: none;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.92) 100%);
}

/* 服务标签 */
.tag-pill {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #e8f5e9;
  border-radius: 28rpx;
  transition: all 0.2s ease;
}

.tag-pill.editing {
  background: #c8e6c9;
}

.tag-text {
  font-size: 26rpx;
  color: #2e7d32;
}

.tag-remove {
  margin-left: 12rpx;
  width: 32rpx;
  height: 32rpx;
  line-height: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 50%;
}

/* 子标签：离标题更远，底部整条极浅灰线，选中绿线压在上面 */
.subtabs {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  border-bottom: 1rpx solid #e0e2e0;
}

.subtab {
  position: relative;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #999;
  font-weight: 400;
}

.subtab.on {
  color: #162116;
  font-weight: 700;
}

.subtab.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  background: #4caf50;
  border-radius: 2rpx;
}

/* 卡片列表：卡片间距 */
.card-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 容器固定 5 张卡高度，多于 5 个区块内滑动 */
.card-scroll {
  height: 838rpx;
}

/* 无卡：容器保持 5 张卡高度，空态居中 */
.card-empty-wrap {
  height: 838rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 记事卡（取自首页 card-item） */
.card-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #f4f5f7;
  border-radius: 24rpx;
}

.card-icon {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.card-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #111816;
  line-height: 44rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  font-size: 24rpx;
  color: #a0a5a1;
  line-height: 34rpx;
  margin-top: 8rpx;
}

.card-status {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  margin-left: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(17, 24, 22, 0.08);
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #68706a;
}

/* 列表状态三态配色：提醒中绿 / 未设提醒琥珀 / 已过期红 */
.status-reminding {
  background: #dcfce7;
  border-color: transparent;
}

.status-reminding .status-text {
  color: #16a34a;
}

.status-no-remind {
  background: #fdf3d7;
  border-color: transparent;
}

.status-no-remind .status-text {
  color: #b26a00;
}

.status-expired {
  background: #fdecea;
  border-color: transparent;
}

.status-expired .status-text {
  color: #e53935;
}

/* 灵感卡区块：标题行（含胶囊）离容器顶、离下面卡片都更舒展 */
.my-home-page .section-inspire {
  padding-top: 40rpx;
}

.my-home-page .section-inspire .section-header {
  margin-bottom: 36rpx;
}

/* 记事卡区块：标题离容器顶增加更多，离下面待确定 tabs 也增加 */
.my-home-page .section-last {
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 56rpx;
}

.my-home-page .section-last .section-header {
  margin-bottom: 36rpx;
}

/* 高度由行内 calc 控制：约等于一屏剩余，滑到该区域后内部滚动 */
.card-empty-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}
