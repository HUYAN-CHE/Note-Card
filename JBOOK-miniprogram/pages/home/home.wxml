<view class="page home-page">
  <pull-create-trigger
    wx:if="{{homeTab === 'note'}}"
    class="home-pull-trigger"
    bind:trigger="onPullCreate"
    bind:selectDay="selectDay"
    title="生活由无数的小事组成"
    label="下拉新建事项"
    threshold="{{150}}"
    max-drag="{{188}}"
    week-days="{{weekDays}}"
    selected-index="{{selectedIndex}}"
    status-bar-height="{{statusBarHeight}}"
    nav-top="{{heroNavTop}}"
    nav-height="{{heroNavHeight}}"
    nav-right="{{heroNavRight}}"
    body-pull-enabled="{{!cards.length}}"
  >
    <!-- 记事/灵感切换胶囊（替代 This week，与微信胶囊同高对齐）；审核版隐藏（灵感功能不上线） -->
    <view slot="nav" class="home-tab-switch" wx:if="{{!reviewMode}}">
      <view class="home-tab {{homeTab === 'note' ? 'active' : ''}}" bindtap="onHomeTabTap" data-tab="note">记事</view>
      <view class="home-tab {{homeTab === 'inspire' ? 'active' : ''}}" bindtap="onHomeTabTap" data-tab="inspire">灵感</view>
    </view>

    <view slot="sheet-head">
      <view class="sheet-grabber"></view>

      <view class="sheet-head">
        <view class="sheet-title-wrap">
          <text class="sheet-title">最近记事卡</text>
          <text class="sheet-subtitle">打开临近消息提醒</text>
        </view>
        <view
          class="reminder-switch-wrap"
          catchtouchmove="onPreventTouchMove"
        >
          <switch
            class="reminder-switch"
            checked="{{reminderEnabled}}"
            color="#22C55E"
            bindchange="toggleReminder"
            aria-label="打开临近消息提醒"
          />
        </view>
      </view>
    </view>

    <pull-refresh-view
      wx:if="{{cards.length}}"
      class="card-list-scroll"
      refresher-enable="{{false}}"
      scroll-y="{{true}}"
      refreshing="{{refreshing}}"
      show-loading="{{false}}"
      bindscroll="onBodyScroll"
      bind:refreshclose="onPullCreateClose"
    >
      <view class="card-list">
        <view wx:for="{{cards}}" wx:key="id" class="swipe-wrap">
          <view class="swipe-delete" style="visibility: {{item.swipeX ? 'visible' : 'hidden'}};" bindtap="onDeleteCard" data-id="{{item.id}}">删除</view>
          <view
            class="swipe-content card-item"
            style="{{item.swipeX ? 'transform: translateX(' + item.swipeX + 'px);' : ''}}"
            bindtap="openCard"
            data-id="{{item.id}}"
            data-index="{{index}}"
            bindtouchstart="onSwipeStart"
            bindtouchmove="onSwipeMove"
            bindtouchend="onSwipeEnd"
            aria-label="打开记事卡 {{item.displayTitle}}"
          >
            <view class="card-icon">{{item.icon}}</view>

            <view class="card-info">
              <text class="card-title">{{item.displayTitle}}</text>
              <text class="card-meta">截止日期 {{item.deadlineText}}</text>
            </view>

            <view class="card-status {{item.statusClass}}" aria-hidden="true">
              <text class="status-text">{{item.statusText}}</text>
            </view>
          </view>
        </view>
      </view>
      <!-- 底部占位：最后一张卡停在渐隐带上方，不钻进 tab-bar 后面 -->
      <view class="card-bottom-space"></view>
    </pull-refresh-view>

    <empty-state wx:else image="/assets/images/empty-state-ref.png" image-size="320" title="还没有记事卡" subtitle="下拉或点击上方按钮，从聊天记录生成一张记事卡" />
  </pull-create-trigger>

  <!-- 灵感页：绿到白渐变 + 双列彩色卡片网格，点击进文章编辑页；审核版隐藏 -->
  <view class="inspire-page" wx:if="{{homeTab === 'inspire' && !reviewMode}}">
    <view class="inspire-bg"></view>
    <view
      class="home-tab-switch inspire-tab-switch"
      style="top: {{statusBarHeight + heroNavTop}}px; height: {{heroNavHeight}}px;"
    >
      <view class="home-tab {{homeTab === 'note' ? 'active' : ''}}" bindtap="onHomeTabTap" data-tab="note">记事</view>
      <view class="home-tab {{homeTab === 'inspire' ? 'active' : ''}}" bindtap="onHomeTabTap" data-tab="inspire">灵感</view>
    </view>
    <scroll-view
      scroll-y="{{true}}"
      class="inspire-scroll"
      style="padding-top: {{statusBarHeight + heroNavTop + heroNavHeight + 28}}px;"
    >
      <view class="inspire-grid" wx:if="{{inspireCards.length}}">
        <view class="inspire-col" wx:for="{{[inspireCols.left, inspireCols.right]}}" wx:for-item="col" wx:key="index">
          <view class="inspire-card" wx:for="{{col}}" wx:key="id" bindtap="openInspireDetail" data-id="{{item.id}}" data-color="{{item.color}}">
            <view class="inspire-card-top" style="background: {{item.color}};">
              <view class="inspire-card-title">{{item.title}}</view>
              <view class="inspire-card-desc">{{item.desc}}</view>
              <view class="inspire-tags">
                <text class="inspire-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
              </view>
            </view>
            <view class="inspire-card-foot">
              <text class="inspire-explore">查看</text>
              <view class="inspire-arrow">→</view>
            </view>
          </view>
        </view>
      </view>
      <view class="inspire-empty-wrap" wx:if="{{!inspireCards.length}}" style="min-height: calc(100vh - {{statusBarHeight + heroNavTop + heroNavHeight + 28}}px);">
        <!-- 审核版：中性空态，不暴露会员/私人助理概念与入口（reviewMode 改 false 后恢复完整版） -->
        <view class="inspire-empty" wx:if="{{reviewMode}}">
          <image class="inspire-empty-image" src="/assets/images/inspire-empty.png" mode="widthFix" aria-hidden="true" />
          <text class="inspire-empty-title">还没有灵感卡</text>
          <text class="inspire-empty-subtitle">零碎的灵感会在这里集采成卡</text>
        </view>
        <!-- 非会员：会员引导（介绍灵感集采为会员专属能力，按钮进会员页） -->
        <view class="inspire-empty" wx:elif="{{memberStatus !== 'active'}}">
          <image class="inspire-empty-image" src="/assets/images/inspire-empty.png" mode="widthFix" aria-hidden="true" />
          <text class="inspire-empty-title">灵感集采 · 会员专属</text>
          <text class="inspire-empty-subtitle">开通会员，获得专属私人助理：灵感随手发给它，自动提取标题与关键词，集满成一篇可编辑的文章</text>
          <view class="inspire-vip-btn" bindtap="openMember">了解会员权益</view>
        </view>
        <!-- 会员暂无数据：按是否已绑定私人助理分流（contactCell 插件加载不稳已移除） -->
        <view class="inspire-empty" wx:else>
          <image class="inspire-empty-image" src="/assets/images/inspire-empty.png" mode="widthFix" aria-hidden="true" />
          <text class="inspire-empty-title">还没有灵感卡</text>
          <!-- 已绑定：纯文案引导去微信发 -->
          <text class="inspire-empty-subtitle" wx:if="{{hasWecomBound}}">已连接私人助理，去微信里把第一条灵感发给 TA，自动集采成卡</text>
          <!-- 未绑定：引导去会员页完成连接 -->
          <block wx:else>
            <text class="inspire-empty-subtitle">先连接私人助理，之后灵感随手发给 TA，自动集采成卡</text>
            <view class="inspire-vip-btn" bindtap="openMember">连接私人助理</view>
          </block>
        </view>
      </view>
      <view class="inspire-bottom-space" wx:if="{{inspireCards.length}}"></view>
    </scroll-view>
  </view>

  <!-- 底部渐隐浮层：两个 tab 共用；tab 区实白不透，向上缓出渐隐（与新建页 footer 渐隐带同款） -->
  <view class="bottom-fade"></view>

  <tab-bar activeTab="home" />

  <!-- 私聊成卡弹窗：每日首次进入弹出，可滑动浏览、直接设提醒时间、点遮罩或按钮关闭 -->
  <bottom-sheet
    visible="{{wecomSheetVisible}}"
    title="私聊新记了 {{wecomDrafts.length}} 张卡"
    subtitle="设个提醒时间，到点微信通知你"
    safe-area-bottom="{{safeAreaBottom}}"
    show-close="{{true}}"
    bind:close="onWecomSheetClose"
  >
    <scroll-view class="wecom-sheet-list" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="wecom-sheet-card" wx:for="{{wecomDrafts}}" wx:key="_id">
        <view class="wecom-sheet-info">
          <text class="wecom-sheet-title">{{item.title}}</text>
          <text class="wecom-sheet-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
        <picker
          class="wecom-sheet-picker {{item.deadline ? 'set' : ''}}"
          mode="date"
          value="{{item.deadline}}"
          data-docid="{{item._id}}"
          bindchange="onSetWecomDeadline"
        >
          {{item.deadline ? item.deadline.slice(5).replace('-', '/') : '设时间'}}
        </picker>
      </view>
    </scroll-view>
    <!-- 灵感沉淀汇总：今日私聊碎片进灵感库的条数，点击切灵感 tab（审核版无灵感功能，不显示） -->
    <view class="wecom-sheet-inspire" wx:if="{{inspireTodayCount && !reviewMode}}" bindtap="onWecomTipInspire">今天还沉淀了 {{inspireTodayCount}} 条灵感到灵感库 →</view>
    <view class="wecom-sheet-done" bindtap="onWecomSheetClose">好了</view>
  </bottom-sheet>

  <!-- 首次登录授权弹窗 -->
  <view class="auth-mask" wx:if="{{showAuthModal}}" catchtap="closeAuthModal">
    <view class="auth-modal" catchtap="onPreventBubble">
      <view class="auth-title">授权登录</view>
      <view class="auth-desc">分别点击头像和昵称完成授权</view>
      <view class="auth-actions">
        <button
          class="auth-avatar-btn {{authProfile.avatar ? 'done' : ''}}"
          open-type="chooseAvatar"
          bind:chooseavatar="onAuthAvatar"
        >
          <text wx:if="{{!authProfile.avatar}}">授权头像</text>
          <image wx:else class="auth-avatar-img" src="{{authProfile.avatar}}" mode="aspectFill" />
        </button>
        <input
          class="auth-nickname-input {{authProfile.nickname ? 'done' : ''}}"
          type="nickname"
          placeholder="点击输入昵称"
          value="{{authProfile.nickname}}"
          bindinput="onAuthNicknameInput"
          maxlength="20"
        />
      </view>
      <view class="auth-close" bindtap="closeAuthModal">稍后再说</view>
    </view>
  </view>
</view>
