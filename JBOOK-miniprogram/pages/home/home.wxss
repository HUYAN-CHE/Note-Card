/* pages/home/home.wxss */

.home-page {
  position: relative;
  min-height: 100vh;
  padding: 0;
  overflow: hidden;
  background: linear-gradient(180deg, #00c853 0%, #00e676 45%, #1de9b6 100%);
}

/* Sheet 头部 */
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.sheet-title-wrap {
  display: flex;
  flex-direction: column;
}

.sheet-title {
  color: #111816;
  font-size: 30rpx;
  font-weight: 400;
  line-height: 42rpx;
}

.sheet-subtitle {
  margin-top: 4rpx;
  color: #9aa19c;
  font-size: 26rpx;
  line-height: 36rpx;
}

.reminder-switch-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.reminder-switch {
  transform: scale(0.84);
  transform-origin: right top;
}

/* 卡片列表 */
.card-list-scroll {
  flex: 1;
  min-height: 0;
  height: 100%;
  margin-top: 34rpx;
}

.create-refresher {
  height: 80px;
}

.sheet-grabber {
  width: 58rpx;
  height: 8rpx;
  margin: 0 auto 34rpx;
  border-radius: 999rpx;
  background: rgba(19, 30, 21, 0.16);
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 左滑删除：底层删除按钮 + 内容层位移；wrap 背景与卡片同色，遮盖内容层圆角透出的红边 */
.swipe-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  background: #f4f5f7;
}

.swipe-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  /* 右圆角与内容层卡片圆角弧度重合，避免卡片四角透明弧透出红色 */
  border-radius: 0 24rpx 24rpx 0;
  background: #e53935;
  color: #fff;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.swipe-content {
  position: relative;
  z-index: 1;
  transition: transform 0.2s ease;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: #f4f5f7;
  border-radius: 24rpx;
}

.card-icon {
  width: 84rpx;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.card-title {
  font-size: 30rpx;
  font-weight: 400;
  color: #111816;
  line-height: 44rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-meta {
  font-size: 24rpx;
  color: #a0a5a1;
  line-height: 34rpx;
  margin-top: 8rpx;
}

.card-status {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 28rpx;
  margin-left: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(17, 24, 22, 0.08);
}

.status-text {
  font-size: 24rpx;
  font-weight: 500;
  color: #68706a;
}

.status-done {
  background: #dcfce7;
  border-color: transparent;
}

.status-done .status-text {
  color: #16a34a;
}

/* 授权弹窗 */
.auth-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.5);
}

.auth-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.auth-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #162116;
  text-align: center;
}

.auth-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7a73;
  text-align: center;
}

.auth-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin-top: 40rpx;
}

.auth-avatar-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 140rpx !important;
  height: 140rpx !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  border-radius: 50% !important;
  background: #f5f7fa !important;
  font-size: 24rpx;
  color: #6b7a73;
  box-sizing: border-box;
  overflow: hidden;
}

.auth-avatar-btn::after {
  display: none;
}

.auth-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.auth-nickname-input {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 80rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  background: #f5f7fa;
  font-size: 28rpx;
  color: #162116;
  line-height: 1;
  text-align: center;
}

.auth-nickname-input.done {
  background: #e8f5e9;
  color: #22c55e;
}

.auth-close {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #9baaa3;
  text-align: center;
}

/* ==================== 记事/灵感切换胶囊 ==================== */

/* 容器：与微信胶囊同高（hero-nav 高度即胶囊高），浅绿半透明底 */
.home-tab-switch {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
}

.home-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 30rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1;
  white-space: nowrap;
}

.home-tab.active {
  background: #ffffff;
  color: #00c853;
}

/* 灵感页切换器：固定在导航区左侧（与微信胶囊同 top 同高） */
.inspire-tab-switch {
  position: fixed;
  left: 44rpx;
  z-index: 20;
}

/* ==================== 灵感页 ==================== */

.inspire-page {
  position: relative;
  min-height: 100vh;
}

.inspire-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, #00c853 0%, #00e676 34%, #a9efc4 62%, #ffffff 88%);
}

.inspire-scroll {
  position: relative;
  z-index: 1;
  height: 100vh;
  box-sizing: border-box;
}

.inspire-grid {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  padding: 12rpx 32rpx 0;
}

/* 瀑布流列：卡片高度随内容自适应（关键词 1-7 不等，不做统一高度） */
.inspire-col {
  width: calc(50% - 14rpx);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.inspire-card {
  width: 100%;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(28, 28, 30, 0.05);
}

.inspire-card-top {
  padding: 32rpx 32rpx 36rpx;
  box-sizing: border-box;
}

.inspire-card-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1c1c1e;
  line-height: 1.35;
}

.inspire-card-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: rgba(28, 28, 30, 0.5);
  line-height: 1.6;
}

.inspire-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 28rpx;
}

.inspire-tag {
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(28, 28, 30, 0.55);
  line-height: 1;
}

.inspire-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.inspire-explore {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 28, 30, 0.45);
}

.inspire-arrow {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(28, 28, 30, 0.5);
}

.inspire-bottom-space {
  height: calc(220rpx + env(safe-area-inset-bottom));
}

/* 底部渐变浮层（灵感 tab）：与互助页一致；z-15 在卡片上、底部 tab(20) 下 */
.bottom-fade {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 15;
  height: calc(240rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  background: linear-gradient(0deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.95) 40%, rgba(255, 255, 255, 0.98) 60%, rgba(255, 255, 255, 0.75) 80%, rgba(255, 255, 255, 0) 100%);
}
