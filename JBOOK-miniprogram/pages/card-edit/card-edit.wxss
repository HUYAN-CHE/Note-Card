.card-edit-page {
  padding-left: 0;
  padding-right: 0;
  padding-bottom: 0;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 紧随顶部创建区，flex 自适应剩余高度，自行裁剪滚动内容 */
.form-scroll {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.nav-save {
  font-size: 30rpx;
  color: #4caf50;
  font-weight: 700;
}

.form {
  /* 顶部间距与左右一致（28rpx）；底部留白 104rpx：与卡片内边距 60rpx 合计 > 渐隐带 160rpx，
     保证静止时开关文字不被罩，间距又不至于过大 */
  padding: 28rpx 28rpx 104rpx;
}

.field {
  margin-bottom: 40rpx;
}

.field-label {
  position: relative;
  padding-left: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #162116;
  margin-bottom: 20rpx;
}

.field-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #4caf50;
}

.required {
  color: #e53935;
}

.field-hint {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: transparent;
  border-bottom: 1rpx solid #ececec;
  border-radius: 0;
  font-size: 28rpx;
  color: #333;
}

.field-textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  background: transparent;
  border-bottom: 1rpx solid #ececec;
  border-radius: 0;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 占位提示色：与截止日期占位统一 #999 */
.field-ph {
  color: #999;
}

.textarea-holder {
  position: relative;
}

/* 模拟占位：替代 textarea 原生 placeholder（iOS 有系统级左偏移），位置与输入文字一致，点击穿透 */
.mock-ph {
  position: absolute;
  left: 24rpx;
  top: 12rpx;
  font-size: 28rpx;
  color: #999;
  line-height: 1.6;
  pointer-events: none;
}

/* 截止日期 */
.deadline-input {
  display: flex;
  align-items: center;
  color: #333;
}

.deadline-input.is-placeholder {
  font-size: 28rpx;
  color: #999;
}

/* 图片附件：圆形队列，与表单占位提示左对齐（24rpx） */
.attachment-list {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding-left: 24rpx;
  box-sizing: border-box;
}

.attachment-item {
  position: relative;
  width: 88rpx;
  height: 88rpx;
}

.attachment-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}

.attachment-remove {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* 添加圆：实底灰 + 深灰图形加号（::before 横 / ::after 竖），与详情页项目圆同风格 */
.attachment-add {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  background: #f6f6f6;
  border-radius: 50%;
}

.attachment-add::before,
.attachment-add::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  background: #bbb;
  border-radius: 2rpx;
}

.attachment-add::before {
  width: 32rpx;
  height: 4rpx;
}

.attachment-add::after {
  width: 4rpx;
  height: 32rpx;
}

/* 可见性开关 */
.toggle-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  margin-top: 8rpx;
}

.toggle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #162116;
}

.toggle-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.switch {
  position: relative;
  width: 88rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #e0e0e0;
  transition: background 0.2s ease;
}

.switch.on {
  background: #4caf50;
}

.switch-knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s ease;
}

.switch.on .switch-knob {
  transform: translateX(40rpx);
}

/* 底部 */
/* 渐隐带：footer 顶边向上延伸 110rpx（见 .footer::before），盖在滚动内容上形成渐隐过渡；
   属于 footer 的一部分，位置随 footer 实际高度自适应，无需测量/估算 */

/* footer 文档流沉底（不再 fixed）：scroll-view 底边紧贴 footer 顶边，结构上无重叠遮挡；
   白底衔接上方表单区，避免透出页面米色渐变造成断层 */
.footer {
  flex: none;
  position: relative;
  display: flex;
  flex-direction: column;
  /* 元宝风格：两模块成组浮起，间距收紧，容器透明不透底 */
  gap: 20rpx;
  padding: 0 32rpx 24rpx;
  background: #ffffff;
}

.footer::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -160rpx;
  height: 160rpx;
  pointer-events: none;
  /* 多段停靠模拟缓出曲线：透明度衰减慢→快，比线性过渡自然 */
  background: linear-gradient(0deg,
    rgba(255, 255, 255, 1) 0%,
    rgba(255, 255, 255, 0.85) 28%,
    rgba(255, 255, 255, 0.6) 48%,
    rgba(255, 255, 255, 0.32) 68%,
    rgba(255, 255, 255, 0.12) 85%,
    rgba(255, 255, 255, 0) 100%);
}

/* 元宝风格：浅灰圆角矩形面板，把会员行与生成按钮连成一体 */
.footer-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx;
  background: #f4f4f2;
  border-radius: 32rpx;
}

.footer-btn {
  width: 100%;
  box-sizing: border-box;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999rpx;
  text-align: center;
}

.footer-btn.primary {
  color: #fff;
  background: #4caf50;
  box-shadow: 0 12rpx 32rpx rgba(76, 175, 80, 0.35);
}

/* 顶部快速创建区：文档流（不再 fixed），实白底 */
.float-create-card {
  flex: none;
  position: relative;
  z-index: 2;
  /* 仅底部白边加厚一倍，左右保持 28rpx 不动 */
  padding: 0 28rpx 40rpx;
  box-sizing: border-box;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

/* 快速创建卡片 */
.create-card {
  padding: 24rpx;
  background: linear-gradient(150deg, #b8f0cf 0%, #a8ebc5 50%, #b8f0df 100%);
  border-radius: 24rpx;
}

.create-card.compact {
  padding: 24rpx;
}

/* VIP 入口横幅：胶囊长圆条，浅绿与主题协调；置于底部 footer 按钮上方 */
.vip-banner {
  display: flex;
  align-items: center;
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx 8rpx 0;
  background: transparent;
}

.vip-banner-icon {
  width: 34rpx;
  height: 34rpx;
  flex: none;
}

.vip-banner-text {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-left: 14rpx;
  white-space: nowrap;
  overflow: hidden;
}

/* 「会员专享：」深色加粗，与灰色后文区分；同字号保证基线对齐 */
.vip-banner-title {
  flex: none;
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.vip-banner-desc {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-banner-btn {
  flex: none;
  margin-left: 16rpx;
  padding: 10rpx 24rpx;
  background: #4caf50;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}

.create-card-input {
  width: 100%;
  height: 140rpx;
  min-height: 140rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.create-card-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.create-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0;
  background: rgba(255, 255, 255, 0.95);
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #162116;
}

.create-btn.primary {
  background: #101816;
  color: #f7f2e8;
}

.create-btn.recording {
  background: #e53935;
  color: #fff;
}

/* 录音中：闪烁白点 + 声波条 */
.rec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffffff;
  animation: rec-blink 1s ease-in-out infinite;
}

.rec-wave {
  display: flex;
  align-items: center;
  gap: 6rpx;
  height: 32rpx;
}

.rec-bar {
  width: 6rpx;
  border-radius: 3rpx;
  background: #ffffff;
  transform-origin: center;
  animation: rec-wave 1s ease-in-out infinite;
}

.rec-bar.b1 { height: 14rpx; animation-delay: 0s; }
.rec-bar.b2 { height: 26rpx; animation-delay: 0.15s; }
.rec-bar.b3 { height: 32rpx; animation-delay: 0.3s; }
.rec-bar.b4 { height: 22rpx; animation-delay: 0.45s; }
.rec-bar.b5 { height: 12rpx; animation-delay: 0.6s; }

.create-btn.disabled {
  opacity: 0.5;
}

.create-btn-icon {
  width: 32rpx;
  height: 32rpx;
  flex: none;
}

.create-btn-icon.white {
  filter: brightness(0) invert(1);
}

@keyframes rec-wave {
  0%, 100% { transform: scaleY(0.45); }
  50% { transform: scaleY(1); }
}

@keyframes rec-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

/* 信息卡片 */
.info-card {
  padding: 60rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
}

.info-card .field:last-child {
  margin-bottom: 0;
}

.info-card .toggle-row {
  padding: 28rpx 0 0;
  margin-top: 8rpx;
  border-top: 1rpx solid #f2f2f2;
}
