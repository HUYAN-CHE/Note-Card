/* 壳不滚、内容滚：同新建记事卡，.page 自带渐变背景自然固定 */
.inspire-list-page {
  padding: 0;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.list-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

/* 双列瀑布流：卡片高度随内容自适应（关键词 1-7 不等，不做统一高度） */
.inspire-grid {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
}

.inspire-col {
  width: calc(50% - 14rpx);
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.inspire-card {
  width: 100%;
  border-radius: 24rpx;
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(28, 28, 30, 0.05);
}

.inspire-card-top {
  padding: 32rpx 32rpx 36rpx;
  box-sizing: border-box;
}

.inspire-card-title {
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #1c1c1e;
  line-height: 1.35;
}

.inspire-card-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: rgba(28, 28, 30, 0.5);
  line-height: 1.6;
}

.inspire-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 28rpx;
}

.inspire-tag {
  padding: 9rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  font-size: 20rpx;
  font-weight: 400;
  color: rgba(28, 28, 30, 0.55);
  line-height: 1;
}

.inspire-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
}

.inspire-explore {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 28, 30, 0.45);
}

/* 状态筛选 tab（与文章页状态胶囊同一视觉语言） */
.status-tabs {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.status-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(28, 28, 30, 0.55);
  line-height: 1.4;
}

.status-tab.active {
  background: #1c1c1e;
  color: #ffffff;
  font-weight: 600;
}

.list-empty {
  position: relative;
  z-index: 1;
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: rgba(28, 28, 30, 0.45);
}

.inspire-arrow {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: rgba(28, 28, 30, 0.5);
}
