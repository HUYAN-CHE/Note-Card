/* 页面画布铺底色防露底；渐变画在固定层上 */
page {
  background: #f9fcf9;
}

/* 固定背景层：position fixed 不随内容滚动 */
.page-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
  background: linear-gradient(180deg, #7ebc8a 0%, #91c79c 28%, #d0e7d6 55%, #f7faf8 78%, #f9fcf9 100%);
}

/* 壳不滚、内容滚：scroll-view 接管纵向滚动（同灵感详情页） */
.card-detail-page {
  padding: 0;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* 导航底衬：fixed 铺满导航区（height 内联注入），与出票口背板/顶梁同为深绿 #2e7d4e，
   z-99 在导航组件（100）之下、其余内容之上——纸芯顶部伸进导航区时被它遮住 */
.nav-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #2e7d4e;
  z-index: 99;
  pointer-events: none;
}

.detail-body {
  position: relative;
  z-index: 1;
  /* 短卡兜底：内容不足一屏多时也撑出 ~140px 可滚距离，保证上推能把票根
     缺口（虚线两端半圆，卡顶下 196rpx±20rpx）整个收进出票口顶梁（高 40rpx），
     而不是悬停在缺口半露的位置 */
  min-height: calc(100vh + 280rpx);
}

/* ==================== 主卡 ==================== */

/* 主卡框架：不遮罩；出票口（顶梁+背板）整体 fixed，卡片从框里滑出 */
.g-card {
  position: relative;
  margin: 8rpx 48rpx 0;
}

/* 出票口：顶梁 fixed 在导航正下方（top 内联注入），白卡上滑时被顶梁遮挡；
   高 40rpx（减半、出口上移），与卡顶（导航下 12px + 8rpx）保持约 4px 搭接；
   不带投影——两侧上下与背板一体深绿，无阴影边缘感 */
.receipt-slot {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  height: 40rpx;
  background: #2e7d4e;
  z-index: 40;
  pointer-events: none;
}

/* 出口阴影：固定在顶梁下缘（在 z-40 容器内，压在滑动的卡片上，不随卡走）；
   紧贴出口最深、多段非线性衰减到消失（参考 KAPA 出口投影），宽度与卡片一致；
   88rpx 全程落在票头空白上（卡顶到品牌行 120rpx > 96rpx 影程），碰不到品牌行与缺口 */
.receipt-slot::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 26rpx;
  right: 26rpx;
  height: 88rpx;
  background: linear-gradient(180deg,
    rgba(20, 40, 25, 0.42) 0%,
    rgba(20, 40, 25, 0.28) 22%,
    rgba(20, 40, 25, 0.15) 48%,
    rgba(20, 40, 25, 0.06) 74%,
    rgba(20, 40, 25, 0) 100%);
  pointer-events: none;
}

/* 出票口背板：fixed 从屏幕顶铺到顶梁下 300rpx（top/height 内联注入，下缘位置不变），
   左右撑满，层级靠 DOM 顺序垫在卡片下、page-bg 上。卡片白底盖住中间，两侧与上方透深绿；
   上缺口正后方就是它——静止时缺口透深绿，滑动时缺口下面是什么透什么；
   下拉橡皮筋时顶梁与卡顶的缝透出它——深绿，像机器变高 */
.receipt-frame {
  position: fixed;
  left: 0;
  right: 0;
  background: #2e7d4e;
  border-radius: 0 0 28rpx 28rpx;
  pointer-events: none;
}

/* 锯齿底边：白色三角齿咬住卡底，齿缝透出页面背景；齿列居中排列，两端对称不出残齿 */
.g-card::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -17rpx;
  height: 18rpx;
  background:
    linear-gradient(135deg, #ffffff 9rpx, transparent 0) 50% 0,
    linear-gradient(225deg, #ffffff 9rpx, transparent 0) 50% 0;
  background-size: 18rpx 18rpx;
  background-repeat: repeat-x;
  z-index: 1;
}

/* 内层卡体：白色、上下直角——顶部与出票口顶梁平齐贴合，底部贴满宽直锯齿
   （底部若留圆角，圆弧会与直锯齿两端错位，两侧露馅）。
   票头空白 72rpx：品牌行贴近出口，顶部落在影尾淡区（≤6% 灰，基本无感）。
   不带投影——绿色投影的模糊边缘会渗进两侧缺口，让真镂空看着像涂了色的圆片 */
.g-card-inner {
  position: relative;
  z-index: 1;
  padding: 72rpx 48rpx 56rpx;
  background: #ffffff;
  border-radius: 0;
}

/* 票根缺口：mask 在卡片两端各镂空一个半圆（上缺口在品牌行下虚线位 196rpx，
   下缺口距卡底 270rpx，与撕裂线同位），镂空处透出真实页面背景 */
.g-card-ticket {
  -webkit-mask-image:
    radial-gradient(circle 20rpx at 0 196rpx, transparent 19rpx, #000 16rpx),
    radial-gradient(circle 20rpx at 100% 196rpx, transparent 19rpx, #000 16rpx),
    radial-gradient(circle 20rpx at 0 calc(100% - 270rpx), transparent 19rpx, #000 16rpx),
    radial-gradient(circle 20rpx at 100% calc(100% - 270rpx), transparent 19rpx, #000 16rpx);
  -webkit-mask-composite: destination-in;
  mask-image:
    radial-gradient(circle 20rpx at 0 196rpx, transparent 19rpx, #000 16rpx),
    radial-gradient(circle 20rpx at 100% 196rpx, transparent 19rpx, #000 16rpx),
    radial-gradient(circle 20rpx at 0 calc(100% - 270rpx), transparent 19rpx, #000 16rpx),
    radial-gradient(circle 20rpx at 100% calc(100% - 270rpx), transparent 19rpx, #000 16rpx);
  mask-composite: intersect;
}

/* 品牌行：[条形码] [MEW.JOT logo] [条形码] */
.g-brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
}

/* MEW.JOT 矢量 logo（9SVG.svg 原件裁剪后引入，aspect ≈ 832:869） */
.g-brand-logo {
  width: 77rpx;
  height: 80rpx;
}

/* 两侧条形码：三层不同周期的黑/透明竖条渐变叠加，摩尔出粗细不均的条码肌理 */
.g-brand-barcode {
  width: 180rpx;
  height: 24rpx;
  background:
    repeating-linear-gradient(90deg, #1a1a1a 0, #1a1a1a 3rpx, transparent 3rpx, transparent 8rpx),
    repeating-linear-gradient(90deg, #1a1a1a 0, #1a1a1a 2rpx, transparent 2rpx, transparent 11rpx),
    repeating-linear-gradient(90deg, #1a1a1a 0, #1a1a1a 4rpx, transparent 4rpx, transparent 17rpx);
}

/* 标题行：位于品牌行下虚线之下（虚线不占文档流，间距在此补齐；
   标题顶 = 虚线下 60rpx，与「截止日期」离下虚线的间距一致；品牌行高 88rpx 时 margin 取 96rpx） */
.g-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 96rpx;
}

/* 标题：最多两行 */
.g-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2b1e;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 状态小字样式已移除：标题右侧改为进度选择胶囊（.g-progress-pill） */

/* 行标签：弱化成小字标签（24rpx 浅绿灰、加字距），退居二线让内容当主角；
   标题下浅色分隔线（同 .g-section 的 1rpx #dce8de，不出内容区） */
.g-row-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 48rpx;
  padding-top: 48rpx;
  border-top: 1rpx solid #dce8de;
}

.g-label {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #7f8f83;
}

.g-label-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

/* 行标签不分大小号：全卡同式 */
.g-label-lg {
  font-size: 24rpx;
}

.g-label-lg .g-label-icon {
  width: 26rpx;
  height: 26rpx;
}

.g-hint {
  font-size: 24rpx;
  color: #9aa79c;
  text-align: right;
}

/* 头像链：creator --link-- helpers -- 加号；与上行标签间距 28rpx（标签→内容亲近距） */
.g-avatars-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
}

.g-avatars {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.g-avatar {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: linear-gradient(150deg, #4caf50, #81c784);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
  padding: 0;
}

.g-avatar image {
  width: 70rpx;
  height: 70rpx;
}

/* 头像组：叠加排布，白色描边分隔；统一叠压 -10rpx */
.g-avatar + .g-avatar {
  margin-left: -10rpx;
}

/* 更多协作人圆：三个图形圆点居中 */
.g-avatar-more {
  background: #e6ece7;
}

/* 添加圆：头像链尾，浅灰底+白描边+居中十字（点击=邀请协作分享）；
   叠压 margin 在 wxml 内联（button 内置样式会覆盖类样式） */
.g-avatar-add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 70rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 50%;
  border: 3rpx solid #fff;
  background: #f0f3f0;
  line-height: 1;
  flex-shrink: 0;
}

.g-avatar-add::after {
  display: none;
}

.g-avatar-add-plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.g-avatar-add-plus::before {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 100%;
  border-radius: 2rpx;
  background: #9aa79c;
  transform: translateX(-50%);
}

.g-avatar-add-plus::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  width: 100%;
  height: 4rpx;
  border-radius: 2rpx;
  background: #9aa79c;
  transform: translateY(-50%);
}

.g-more-dots {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.g-more-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #8a978a;
}

/* 项目胶囊：头像链最前，深绿底白字；无附件=胶囊+标题前4字（超4字省略），
   有附件=左端内嵌同高圆图+文字（多张带数量角标），点击放大可左右滑 */
.g-project-pill {
  position: relative;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #2e7d4e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
}

/* 有附件：圆图占满胶囊左端（直径=胶囊高），padding 让位 */
.g-project-pill.has-thumb {
  padding-left: 0;
}

.g-project-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.g-avatar-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #49854f;
  border: 2rpx solid #fff;
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 链接符：UI 稿链条 icon，位于项目胶囊与头像组之间 */
.g-link-icon {
  width: 34rpx;
  height: 20rpx;
  margin: 0 6rpx;
  flex-shrink: 0;
}

/* 卡内邀请按钮已移除（底部 footer 保留邀请协作）；项目胶囊复用其底色/文字样式 */

/* 重点 / 待确认：顶部分割线②（共同行动人|重点） */
.g-section {
  margin-top: 48rpx;
  padding-top: 48rpx;
  border-top: 1rpx solid #dce8de;
}

/* 正文：26rpx，行高 1.8 */
.g-desc {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #4d5c51;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

/* 标签：实测背景 #eef8f0，文字 #49854f */
.g-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.g-tag {
  padding: 10rpx 24rpx;
  border-radius: 12rpx;
  background: #eef8f0;
  color: #49854f;
  font-size: 24rpx;
  font-weight: 500;
}

/* KV 行：进度→截止间距 44rpx */
.g-kv-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 44rpx;
}

/* KV 区顶部分隔线③（重点|截止日期；原「当前进度」行已并入标题右侧胶囊） */
.g-kv-row-lg {
  margin-top: 48rpx;
  padding-top: 48rpx;
  border-top: 1rpx solid #dce8de;
}

/* KV 值：与全卡字号统一 24rpx；右端贴内容缘，与其他右侧元素对齐 */
.g-kv-value {
  margin-right: 0;
  font-size: 24rpx;
  color: #1a2b1e;
  font-weight: 600;
}

.g-kv-value.muted {
  color: #b9c6bc;
  font-weight: 400;
}

.g-kv-value.overdue {
  color: #e53935;
}

/* 进度选择胶囊：白底浅绿描边，统一绿色 */
.g-progress-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 52rpx;
  min-width: 148rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 2rpx solid #d5e5d9;
  background: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  color: #49854f;
}

.g-progress-pill.can-pick {
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 78, 0.1);
}

/* 标题行内的进度胶囊：贴右、不被标题挤压 */
.g-head .g-progress-pill {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.g-progress-arrow {
  font-size: 28rpx;
}

/* 撕裂虚线（票根）：虚线中心与 mask 孔中心严格对齐；两端超出卡内 padding 直到卡边 */
.g-tearline {
  position: absolute;
  left: -48rpx;
  right: -48rpx;
  border-top: 4rpx dotted #a9bdae;
}

/* 上缺口虚线：品牌行下（120 票头 + 76 品牌行 = 196rpx，与 mask 孔同位） */
.g-tearline-top {
  top: 196rpx;
}

/* 下缺口虚线：距卡底 268rpx（底部区块加高，接近 KAPA 票尾留白比例），与底部 mask 孔同位 */
.g-tearline-bottom {
  bottom: 266rpx;
}

/* CARD ID 区（撕裂线不占文档流，间距在此补齐：虚线上方约 60rpx、下方约 70rpx） */
.g-cardid-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 130rpx;
}

.g-cardid-left {
  display: flex;
  flex-direction: column;
}

.g-cardid-label {
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #a9b5ab;
}

.g-cardid-code {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #49854f;
  font-family: 'Courier New', Courier, monospace;
}

.g-cardid-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a9b5ab;
}

/* 二维码：实测约 140rpx */
.g-qrcode {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.g-qrcode-placeholder {
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
  border: 2rpx dashed #b9d6c2;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #49854f;
  font-family: 'Courier New', Courier, monospace;
}

/* ==================== 显影动画 ==================== */

.card-in {
  animation: card-fade 0.35s ease both;
}

@keyframes card-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 生成路径：出票机打印——卡片从出口（顶梁）匀速滑出，总时长 2s，与打印音效同步。
   初始整卡上移 90% 藏到顶梁/导航后，滑出过程中顶梁（z-40）遮住上方，纸从出口逐渐出来 */
.developing.card-in {
  animation: print-out 2s cubic-bezier(0.3, 0.6, 0.4, 1) both;
}

@keyframes print-out {
  0% {
    transform: translateY(-90%);
  }
  100% {
    transform: translateY(0);
  }
}

/* 打印滑出时内容随卡一起出来，不做分段浮现 */
.developing .dev {
  animation: none;
}

/* ==================== 审批区 ==================== */

/* 审批区：不上白卡——白卡会顶着主卡锯齿底，两个上圆角在底部白雾 fade 里显形，
   像主卡底下漏出来的；改为标签+浅绿申请块直接落在页面背景上 */
.detail-section {
  margin: 48rpx 48rpx 28rpx;
}

.detail-section .g-label {
  display: block;
  margin-bottom: 20rpx;
}

.request-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.request-item {
  padding: 20rpx;
  background: #f4f8f5;
  border-radius: 20rpx;
}

.request-user {
  display: flex;
  align-items: flex-start;
}

.request-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #4caf50, #81c784);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.request-avatar image {
  width: 56rpx;
  height: 56rpx;
}

.request-info {
  margin-left: 16rpx;
  flex: 1;
  min-width: 0;
}

.request-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a2b1e;
}

.request-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8a938c;
  line-height: 1.4;
}

.request-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.request-btn {
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.request-btn.approve {
  color: #fff;
  background: #77b882;
}

.request-btn.reject {
  color: #666;
  background: #eeeeee;
}

/* ==================== 底部操作（悬浮无底栏，实测高 112rpx） ==================== */

/* 底部渐变浮层：与 card-edit/互助页一致；z-40 在滚动内容上、按钮(.detail-footer z-50)下 */
.bottom-fade {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  height: calc(360rpx + env(safe-area-inset-bottom));
  pointer-events: none;
  background: linear-gradient(0deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.95) 40%, rgba(255, 255, 255, 0.98) 60%, rgba(255, 255, 255, 0.75) 80%, rgba(255, 255, 255, 0) 100%);
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 28rpx;
  padding: 0 48rpx;
  z-index: 50;
}

.footer-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  border-radius: 16rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 600;
}

.footer-btn::after {
  display: none;
}

.footer-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 10rpx;
}

/* 左：实测浅绿 #ecf5ed（保存卡片） */
.footer-btn.ghost {
  background: #ecf5ed;
  color: #49854f;
  box-shadow: 0 10rpx 28rpx rgba(46, 125, 78, 0.16);
}

/* 右：实测绿 #77b882（邀请协作） */
.footer-btn.primary {
  background: #77b882;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(46, 125, 78, 0.3);
}

.footer-btn.wide {
  width: 100%;
}

.footer-btn[disabled] {
  background: #e0e0e0;
  color: #999;
}

/* 弹窗内共同行动人：「添加」格固定左端不滚动（仅有权限），成员横滑从旁边过（同互助页） */
.member-row {
  display: flex;
  align-items: flex-start;
  margin-top: 20rpx;
}

.member-scroll {
  width: auto;
  min-width: 0;
  white-space: nowrap;
}

.member-row .member-scroll {
  flex: 1;
}

.member-track {
  display: inline-flex;
  gap: 24rpx;
  padding-right: 24rpx;
}

.member-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  background: transparent;
  line-height: 1;
}

.member-add::after {
  display: none;
}

.member-add-circle {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #f0f3f0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-add-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #9aa79c;
}

.edit-member {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
}

.edit-member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #4caf50, #81c784);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  flex-shrink: 0;
}

.edit-member-avatar image {
  width: 88rpx;
  height: 88rpx;
}

.edit-member-name {
  margin-top: 8rpx;
  max-width: 96rpx;
  font-size: 20rpx;
  color: #1a2b1e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.edit-member-role {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #9aa79c;
}

/* 申请 Sheet */
.apply-body {
  padding-top: 8rpx;
}

.apply-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

.sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
  text-align: center;
}

.sheet-btn::after {
  display: none;
}

.sheet-btn.ghost {
  color: #666;
  background: #f0f0f0;
}

.sheet-btn.primary {
  color: #fff;
  background: #77b882;
}

/* 海报画布：离屏放置，不参与布局 */
.poster-canvas {
  position: fixed;
  left: -2200px;
  top: 0;
  width: 750px;
  height: 1120px;
}

/* 协作记录入口：替换原「点击下方分享邀请」提示位 */
.g-activity-entry {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-right: 0;
  font-size: 24rpx;
  font-weight: 400;
  color: #b9c6bc;
}

.g-activity-icon {
  width: 24rpx;
  height: 24rpx;
}

.g-desc-empty {
  color: #49854f;
}

/* 编辑 Sheet */
.edit-body {
  padding-top: 8rpx;
}

.edit-field {
  margin-bottom: 24rpx;
}

.edit-label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #5a6355;
  margin-bottom: 12rpx;
}

.edit-label-hint {
  margin-left: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
}

.edit-ph {
  color: #999;
}

.edit-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.edit-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
}

/* 协作记录 Sheet */
.activity-body {
  padding-top: 8rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.activity-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9aa79c;
}

.activity-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2ee;
}

.activity-item:last-child {
  border-bottom: none;
}

.activity-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #e8f0e7;
  color: #49854f;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.activity-avatar image {
  width: 100%;
  height: 100%;
}

.activity-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.activity-text {
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.activity-name {
  font-weight: 600;
  color: #1a2b1e;
}

.activity-time {
  font-size: 22rpx;
  color: #9aa79c;
}
