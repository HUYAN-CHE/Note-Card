<view class="page card-detail-page">
  <custom-nav title="记事卡详情" showBack="{{true}}" theme="deep" statusBarHeight="{{statusBarHeight}}" navHeight="{{navHeight}}" />

  <!-- 固定背景层：不随内容滚动 -->
  <view class="page-bg"></view>

  <!-- 导航底衬：与 page-bg 顶部同色的固定条（z-99，导航文字之下），
       遮住伸进导航区的纸芯/内容——顶梁上方永远不露出白色 -->
  <view class="nav-bg" style="height: {{totalHeight}}px;" aria-hidden="true"></view>

  <!-- 出票口：顶梁 fixed 在导航下方（z-40），白卡上滑时被顶梁遮挡；
       出口深邃感在顶梁自身（下缘渐深 + 12rpx 窄缝影），阴影不投到卡面上 -->
  <view class="receipt-slot" style="top: {{totalHeight}}px;"></view>

  <!-- 出票口背板：固定深绿板（与顶梁同色 #2e7d4e），从屏幕顶铺到顶梁下 300rpx，左右撑满，
       垫在卡片下面（DOM 在 detail-body 前）。卡片白底盖住中间，两侧与上方透深绿；
       上缺口正后方就是它——静止时缺口透深绿，滑动时缺口滑出背板范围则透页面背景 -->
  <view class="receipt-frame" style="top: 0; height: calc({{totalHeight}}px + 340rpx);" aria-hidden="true"></view>

  <!-- 壳不滚、内容滚：scroll-view 接管纵向滚动，enhanced 下隐藏右侧滚动条 -->
  <scroll-view class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="detail-body" style="padding-top: {{totalHeight + 12}}px; padding-bottom: calc(220rpx + {{safeAreaBottom}}px);">

    <!-- 主卡框架：不遮罩；卡片从固定出票口里滑出 -->
    <view class="g-card {{developing ? 'developing' : ''}} {{cardReady ? 'card-in' : ''}}">
      <view class="g-card-inner g-card-ticket">

      <!-- 品牌行：[条形码] [MEW.JOT 矢量 logo] [条形码]（logo 用 9SVG.svg 原件；条码与 logo 同中线） -->
      <view class="dev dev-brand g-brand" aria-hidden="true">
        <view class="g-brand-barcode"></view>
        <image class="g-brand-logo" src="/assets/icons/9SVG.svg" mode="aspectFit" />
        <view class="g-brand-barcode"></view>
      </view>

      <!-- 品牌行下撕裂虚线（票根上缺口） -->
      <view class="dev dev-top g-tearline g-tearline-top"></view>

      <!-- 标题 + 状态胶囊（点标题区编辑标题/重点；右侧胶囊点开状态说明，catchtap 防冒泡触发编辑） -->
      <view class="dev dev-1 g-head {{canEditStatus ? 'can-edit' : ''}}" bindtap="openEditSheet">
        <text class="g-title">{{displayTitle}}</text>
        <view class="g-progress-pill {{statusClass}}" catchtap="onStatusTap">
          <text>{{statusText}}</text>
        </view>
      </view>

      <!-- 共同行动人 -->
      <view class="dev dev-2 g-row-label">
        <view class="g-label g-label-lg">
          <image class="g-label-icon" src="/assets/icons/users.svg" mode="aspectFit" />
          <text>共同行动人</text>
        </view>
        <view class="g-hint g-activity-entry" wx:if="{{isCreator || isHelper}}" bindtap="openActivitySheet" aria-label="协作记录">
          <image class="g-activity-icon" src="/assets/icons/activity-gray.svg" mode="aspectFit" />
          <text>协作记录</text>
        </view>
      </view>
      <view class="dev dev-3 g-avatars-row">
        <view class="g-avatars">
          <!-- 项目胶囊：邀请胶囊同款底色；无附件显示标题前4字，有附件左端内嵌同高圆图（多张带角标），点击放大可左右滑 -->
          <view class="g-project-pill {{projectThumb ? 'has-thumb' : ''}}" bindtap="onProjectAvatarTap" aria-label="项目图片">
            <image wx:if="{{projectThumb}}" class="g-project-thumb" src="{{projectThumb}}" mode="aspectFill" />
            <text class="g-project-name">{{projectLabel}}</text>
            <view class="g-avatar-badge" wx:if="{{attachments.length > 1}}">{{attachments.length}}</view>
          </view>
          <image class="g-link-icon" src="/assets/icons/link.svg" mode="aspectFit" />
          <view class="g-avatar" wx:for="{{visibleAvatars}}" wx:key="index" bindtap="onAvatarTap">
            <text wx:if="{{!item.avatar}}">{{item.initial}}</text>
            <image wx:else src="{{item.avatar}}" mode="aspectFill" />
          </view>
          <view class="g-avatar g-avatar-more" wx:if="{{showAvatarMore}}" bindtap="onAvatarTap" aria-label="查看全部共同行动人">
            <view class="g-more-dots">
              <view class="g-more-dot"></view>
              <view class="g-more-dot"></view>
              <view class="g-more-dot"></view>
            </view>
          </view>
        </view>
      </view>

      <!-- 事情详情 · 重点（创立者/共同行动人可点击编辑） -->
      <view class="dev dev-4 g-section {{canEditStatus ? 'can-edit' : ''}}" wx:if="{{card.desc || keyPoints.length || canEditStatus}}" bindtap="openEditSheet">
        <view class="g-label g-label-lg">
          <image class="g-label-icon" src="/assets/icons/flag.svg" mode="aspectFit" />
          <text>事情详情 · 重点</text>
        </view>
        <text class="g-desc" wx:if="{{card.desc}}">{{card.desc}}</text>
        <view class="g-tags" wx:if="{{keyPoints.length}}">
          <text class="g-tag" wx:for="{{keyPoints}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="g-desc g-desc-empty" wx:if="{{!card.desc && !keyPoints.length}}">点击补充事情详情与重点</text>
      </view>

      <!-- 截止日期（创立者/共同行动人可点击选择；承接 KV 区顶部分隔线③） -->
      <view class="dev dev-6 g-kv-row g-kv-row-lg">
        <view class="g-label g-label-lg">
          <image class="g-label-icon" src="/assets/icons/calendar.svg" mode="aspectFit" />
          <text>截止日期</text>
        </view>
        <picker mode="date" value="{{card.deadline}}" bindchange="onDeadlineChange" disabled="{{!canEditStatus}}">
          <view class="g-kv-value {{card.deadline ? (isOverdue ? 'overdue' : '') : 'muted'}}">{{displayDeadline || '点击设置'}}</view>
        </picker>
      </view>

      <!-- 撕裂虚线（票根下缺口） -->
      <view class="dev dev-7 g-tearline g-tearline-bottom"></view>

      <!-- CARD ID + 小程序码 -->
      <view class="dev dev-8 g-cardid-row">
        <view class="g-cardid-left" bindtap="onCopyRefCode" data-action="copy-refcode" aria-label="复制 Agent 口令">
          <text class="g-cardid-label">CARD ID</text>
          <text class="g-cardid-code">{{refCode ? '#' + refCode : '# · · ·'}}</text>
          <text class="g-cardid-hint">点击复制 Agent 口令</text>
        </view>
        <image class="g-qrcode" src="{{qrCodeSrc}}" mode="aspectFit" wx:if="{{qrCodeSrc}}" />
        <view class="g-qrcode-placeholder" wx:else>{{refCode || '···'}}</view>
      </view>
      </view>
    </view>

    <!-- 审批区（仅创作者） -->
    <view class="detail-section" wx:if="{{isCreator && pendingRequests.length}}">
      <view class="g-label">加入申请</view>
      <view class="request-list">
        <view class="request-item" wx:for="{{pendingRequests}}" wx:key="id">
          <view class="request-user">
            <view class="request-avatar">
              <text wx:if="{{!item.avatar}}">{{item.initial}}</text>
              <image wx:else src="{{item.avatar}}" mode="aspectFill" />
            </view>
            <view class="request-info">
              <text class="request-name">{{item.nickname || '未知用户'}}</text>
              <text class="request-note" wx:if="{{item.note}}">{{item.note}}</text>
            </view>
          </view>
          <view class="request-actions">
            <view class="request-btn reject" bindtap="approveRequest" data-id="{{item.id}}" data-approved="{{false}}">拒绝</view>
            <view class="request-btn approve" bindtap="approveRequest" data-id="{{item.id}}" data-approved="{{true}}">通过</view>
          </view>
        </view>
      </view>
    </view>
  </view>
  </scroll-view>

  <!-- 底部渐变浮层：滚动内容渐渐隐入按钮区后，层级在内容上、按钮下 -->
  <view class="bottom-fade"></view>

  <!-- 底部操作：主胶囊「邀请好友一起提醒」（样式与新建页统一），下方小字「保存为图片」 -->
  <view class="detail-footer" style="padding-bottom: calc(28rpx + {{safeAreaBottom}}px);" wx:if="{{role !== 'stranger' || isNetworkView || canAcceptInvite || (meReminderSet && !isCreator && !isHelper)}}">
    <view class="footer-main" wx:if="{{isCreator || isHelper}}">
      <button class="footer-btn primary wide" open-type="share" data-action="share" aria-label="提醒一下TA"><image class="footer-icon" src="/assets/icons/share-white.svg" mode="aspectFit" />提醒一下 TA</button>
      <view class="footer-text-link" bindtap="onSavePoster">保存为图片</view>
    </view>
    <!-- 纯关注者（已留意、非创立者/协作人）：补充说明入口 -->
    <view class="footer-main" wx:if="{{meReminderSet && !isCreator && !isHelper}}">
      <button class="footer-btn primary wide" bindtap="openNoteSheet" aria-label="补充说明">补充说明</button>
    </view>
    <!-- 引荐人视角：引荐成功后引导转发给卡主审批 -->
    <button class="footer-btn primary wide" wx:if="{{endorsedForward}}" open-type="share" data-action="share" aria-label="转发给卡主审批">已引荐 · 发给卡主拍板</button>
    <!-- 网络访客（非创建者/协作人，且非邀请入口）：按自己的申请状态渲染底部按钮 -->
    <block wx:if="{{showApplyArea && !endorsedForward}}">
      <button class="footer-btn primary wide" wx:if="{{!myJoinStatus}}" bindtap="openApplySheet">申请加入</button>
      <button class="footer-btn primary wide" wx:elif="{{myJoinStatus === 'pending_intermediary'}}" open-type="share" data-action="share" aria-label="转发给好友引荐">待引荐 · 请好友引荐</button>
      <button class="footer-btn primary wide" wx:elif="{{myJoinStatus === 'pending'}}" disabled>已申请，等着呢</button>
      <button class="footer-btn primary wide" wx:elif="{{myJoinStatus === 'rejected'}}" bindtap="openApplySheet">没通过 · 再申请一次</button>
    </block>
    <button class="footer-btn primary wide" wx:if="{{canAcceptInvite}}" bindtap="acceptInvite">接受邀请</button>
  </view>

  <!-- 申请加入 Sheet -->
  <bottom-sheet visible="{{showApplySheet}}" title="申请加入" subtitle="填写说明，让创立者了解你能帮上什么" safeAreaBottom="{{safeAreaBottom}}" bind:close="closeApplySheet">
    <view class="apply-body">
      <textarea
        class="apply-input"
        value="{{applyMessage}}"
        bindinput="onApplyInput"
        placeholder="例如：我周六有空，可以开车接送..."
        maxlength="200"
        adjust-position="{{true}}"
      />
      <view class="sheet-actions">
        <button class="sheet-btn ghost" bindtap="closeApplySheet">取消</button>
        <button class="sheet-btn primary" bindtap="submitApply">提交申请</button>
      </view>
    </view>
  </bottom-sheet>

  <!-- 补充说明 Sheet（纯关注者：给卡主补充进展，≤200 字） -->
  <bottom-sheet visible="{{showNoteSheet}}" title="补充说明" subtitle="说明会记入协作记录，并通知卡主" safeAreaBottom="{{safeAreaBottom}}" bind:close="closeNoteSheet">
    <view class="apply-body">
      <textarea
        class="apply-input"
        value="{{noteText}}"
        bindinput="onNoteInput"
        placeholder="例如：我问过搬家公司了，周六上午有车..."
        maxlength="200"
        adjust-position="{{true}}"
      />
      <view class="sheet-actions">
        <button class="sheet-btn ghost" bindtap="closeNoteSheet">取消</button>
        <button class="sheet-btn primary" bindtap="submitNote">提交</button>
      </view>
    </view>
  </bottom-sheet>

  <!-- 状态说明 Sheet -->
  <bottom-sheet visible="{{showStatusSheet}}" title="状态说明" safeAreaBottom="{{safeAreaBottom}}" bind:close="closeStatusSheet">
    <view class="status-sheet-body">
      <view class="status-sheet-current">
        <text>当前状态</text>
        <text class="status-sheet-badge {{statusClass}}">{{statusText}}</text>
      </view>
      <text class="status-sheet-text">{{statusExplainText}}</text>
      <text class="status-sheet-rule">多人协作时，谁订阅就提醒谁：有人没订阅不影响进程，已订阅的人照常收到提醒；过期状态也对所有人照常生效。</text>
      <view class="sheet-actions">
        <button wx:if="{{statusClass === 'no-remind'}}" class="sheet-btn primary" bindtap="subscribeFromStatusSheet">订阅提醒</button>
        <button wx:else class="sheet-btn primary" bindtap="closeStatusSheet">知道了</button>
      </view>
    </view>
  </bottom-sheet>

  <!-- 编辑卡片 Sheet（创立者/共同行动人） -->
  <bottom-sheet visible="{{showEditSheet}}" title="编辑记事卡" subtitle="共同行动人与卡片内容" safeAreaBottom="{{safeAreaBottom}}" bind:close="closeEditSheet">
    <view class="edit-body">
      <view class="edit-field">
        <text class="edit-label">共同行动人</text>
        <view class="member-row">
          <!-- 添加格固定左端不滚动（仅有权限），成员横滑从旁边过；与首成员间距 24rpx 同 track gap（button margin 需内联） -->
          <button class="member-add" open-type="share" wx:if="{{isCreator || isHelper}}" data-action="share" aria-label="邀请协作" style="width: 96rpx; flex: none; margin-right: 24rpx;">
            <view class="member-add-circle"><view class="g-avatar-add-plus"></view></view>
            <text class="member-add-text">添加</text>
          </button>
          <scroll-view class="member-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="member-track">
              <view class="edit-member" wx:for="{{allCollaborators}}" wx:key="index">
                <view class="edit-member-avatar">
                  <text wx:if="{{!item.avatar}}">{{item.initial}}</text>
                  <image wx:else src="{{item.avatar}}" mode="aspectFill" />
                </view>
                <text class="edit-member-name">{{item.nickname}}</text>
                <text class="edit-member-role">{{item.roleText}}</text>
              </view>
            </view>
          </scroll-view>
        </view>
      </view>
      <view class="edit-field">
        <text class="edit-label">标题</text>
        <input class="edit-input" value="{{editForm.title}}" bindinput="onEditTitleInput" placeholder="如周六拼车去露营" placeholder-class="edit-ph" maxlength="30" />
      </view>
      <view class="edit-field">
        <text class="edit-label">事情详情</text>
        <textarea class="edit-textarea" value="{{editForm.desc}}" bindinput="onEditDescInput" placeholder="描述一下需要帮忙的事" placeholder-class="edit-ph" maxlength="500" adjust-position="{{true}}" />
      </view>
      <view class="edit-field">
        <view class="edit-label">重点<text class="edit-label-hint">用 · 分隔</text></view>
        <input class="edit-input" value="{{editForm.keyPointsText}}" bindinput="onEditKeyPointsInput" placeholder="时间 · 地点 · 分工" placeholder-class="edit-ph" maxlength="200" />
      </view>
      <view class="sheet-actions">
        <button class="sheet-btn ghost" bindtap="closeEditSheet">取消</button>
        <button class="sheet-btn primary" bindtap="submitEdit">保存</button>
      </view>
    </view>
  </bottom-sheet>

  <!-- 协作记录 Sheet -->
  <bottom-sheet visible="{{showActivitySheet}}" title="协作记录" subtitle="共同行动人的最近操作" safeAreaBottom="{{safeAreaBottom}}" bind:close="closeActivitySheet">
    <view class="activity-body">
      <view class="activity-empty" wx:if="{{!activitiesLoading && !activities.length}}">暂无协作记录</view>
      <view class="activity-empty" wx:if="{{activitiesLoading}}">加载中...</view>
      <view class="activity-item" wx:for="{{activities}}" wx:key="id">
        <view class="activity-avatar">
          <text wx:if="{{!item.actorAvatar}}">{{item.actorInitial}}</text>
          <image wx:else src="{{item.actorAvatar}}" mode="aspectFill" />
        </view>
        <view class="activity-info">
          <text class="activity-text"><text class="activity-name">{{item.actorName}}</text> {{item.detail}}</text>
          <text class="activity-time">{{item.timeText}}</text>
        </view>
      </view>
    </view>
  </bottom-sheet>

  <!-- 全部共同行动人 Sheet（点头像/「…」圆打开，无权限视角） -->
  <bottom-sheet visible="{{showHelpersSheet}}" title="共同行动人" subtitle="{{allCollaborators.length}} 位成员" safeAreaBottom="{{safeAreaBottom}}" bind:close="closeHelpersSheet">
    <scroll-view class="member-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="member-track">
        <view class="edit-member" wx:for="{{allCollaborators}}" wx:key="index">
          <view class="edit-member-avatar">
            <text wx:if="{{!item.avatar}}">{{item.initial}}</text>
            <image wx:else src="{{item.avatar}}" mode="aspectFill" />
          </view>
          <text class="edit-member-name">{{item.nickname}}</text>
          <text class="edit-member-role">{{item.roleText}}</text>
        </view>
      </view>
    </scroll-view>
  </bottom-sheet>

  <!-- 海报画布（离屏渲染，保存卡片时使用） -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>

  <!-- 授权补全弹窗（接受邀请后，与首页授权弹窗同款） -->
  <view class="auth-mask" wx:if="{{showAuthModal}}" catchtap="closeAuthModal">
    <view class="auth-modal" catchtap="onPreventBubble">
      <view class="auth-title">授权登录</view>
      <view class="auth-desc">完善头像和昵称，让协作伙伴认出你</view>
      <view class="auth-actions">
        <button
          class="auth-avatar-btn {{authProfile.avatar ? 'done' : ''}}"
          open-type="chooseAvatar"
          bind:chooseavatar="onAuthAvatar"
        >
          <text wx:if="{{!authProfile.avatar}}">授权头像</text>
          <image wx:else class="auth-avatar-img" src="{{authProfile.avatar}}" mode="aspectFill" />
        </button>
        <input
          class="auth-nickname-input {{authProfile.nickname ? 'done' : ''}}"
          type="nickname"
          placeholder="点击输入昵称"
          value="{{authProfile.nickname}}"
          bindinput="onAuthNicknameInput"
          maxlength="20"
        />
      </view>
      <view class="auth-close" bindtap="closeAuthModal">稍后再说</view>
    </view>
  </view>
</view>
