<view class="page member-page">
  <custom-nav title="会员" showBack="{{true}}" statusBarHeight="{{statusBarHeight}}" navHeight="{{navHeight}}" />

  <scroll-view class="member-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="member-body" style="padding-top: {{totalHeight + 12}}px;">

      <!-- 会员状态卡 -->
      <view class="status-card {{status}}">
        <image class="status-crown" src="/assets/images/icon-crown.svg" mode="aspectFit" />
        <view class="status-info">
          <text class="status-title">记事卡会员</text>
          <text class="status-desc" wx:if="{{status === 'active'}}">有效期至 {{expireAtText}}（还剩 {{daysLeft}} 天）</text>
          <text class="status-desc" wx:elif="{{status === 'expired'}}">已于 {{expireAtText}} 到期，续费后恢复权益</text>
          <text class="status-desc" wx:else>开通后可使用企微小助手全部能力</text>
        </view>
        <view class="status-badge {{status}}" wx:if="{{status === 'active'}}">已开通</view>
        <view class="status-badge {{status}}" wx:elif="{{status === 'expired'}}">已过期</view>
      </view>

      <!-- 会员权益 -->
      <view class="section">
        <view class="section-title">会员权益</view>
        <view class="benefit" wx:for="{{benefits}}" wx:key="title">
          <image class="benefit-icon" src="/assets/icons/icon-sparkle.svg" mode="aspectFit" />
          <view class="benefit-text">
            <text class="benefit-title">{{item.title}}</text>
            <text class="benefit-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 开通流程 -->
      <view class="section">
        <view class="section-title">如何{{status === 'expired' ? '续费' : '开通'}}</view>
        <view class="step">
          <text class="step-num">1</text>
          <text class="step-text">长按下方二维码，添加小助手企业微信</text>
        </view>
        <view class="step">
          <text class="step-num">2</text>
          <text class="step-text">小助手向你发起收款，微信内完成支付</text>
        </view>
        <view class="step">
          <text class="step-num">3</text>
          <text class="step-text">开通成功，回到小程序即可使用全部权益</text>
        </view>

        <!-- 小助手二维码（替换 assets/images/bot-qrcode.png 后生效） -->
        <view class="qrcode-card">
          <image class="qrcode-image" src="/assets/images/bot-qrcode.png" mode="aspectFit" show-menu-by-longpress="{{true}}" wx:if="{{false}}" />
          <view class="qrcode-placeholder">小助手二维码配置中</view>
          <text class="qrcode-tip">长按二维码识别，添加小助手</text>
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>
</view>
