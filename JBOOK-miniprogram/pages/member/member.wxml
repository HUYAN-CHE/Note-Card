<view class="page member-page">
  <custom-nav title="会员" showBack="{{true}}" statusBarHeight="{{statusBarHeight}}" navHeight="{{navHeight}}" />

  <scroll-view class="member-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="member-body" style="padding-top: {{totalHeight + 12}}px;">

      <!-- 会员状态卡 -->
      <view class="status-card {{status}}">
        <image class="status-crown" src="/assets/images/icon-crown.svg" mode="aspectFit" />
        <view class="status-info">
          <text class="status-title">记事卡会员</text>
          <!-- 终身会员不显示剩余天数 -->
          <text class="status-desc" wx:if="{{status === 'active' && plan === 'lifetime'}}">终身有效</text>
          <text class="status-desc" wx:elif="{{status === 'active'}}">有效期至 {{expireAtText}}（还剩 {{daysLeft}} 天）</text>
          <text class="status-desc" wx:elif="{{status === 'expired'}}">已于 {{expireAtText}} 到期，续费后恢复权益</text>
          <text class="status-desc" wx:else>开通后可使用私人助理全部能力</text>
        </view>
        <view class="status-badge {{status}}" wx:if="{{status === 'active'}}">已开通</view>
        <view class="status-badge {{status}}" wx:elif="{{status === 'expired'}}">已过期</view>
      </view>

      <!-- 会员权益 -->
      <view class="section">
        <view class="section-title">会员权益</view>
        <view class="benefit" wx:for="{{benefits}}" wx:key="title">
          <image class="benefit-icon" src="/assets/icons/icon-sparkle.svg" mode="aspectFit" />
          <view class="benefit-text">
            <text class="benefit-title">{{item.title}}</text>
            <text class="benefit-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>

      <!-- 已开通未绑定：先复制会员码，再长按添加私人助理（加完直接粘贴发送） -->
      <view class="section" wx:if="{{!loading && status === 'active' && !hasWecomBound}}">
        <view class="section-title">连接你的私人助理</view>

        <!-- 第一步：复制会员码（会员身份证+绑定码，主路径凭据） -->
        <view class="bindcode-card" wx:if="{{memberCode}}">
          <text class="bindcode-value">{{memberCode}}</text>
          <view class="vip-btn copy-btn" bindtap="onCopyMemberCode">复制</view>
          <text class="qrcode-tip">第一步：复制你的会员码</text>
        </view>

        <!-- 第二步：企微「联系我」二维码（多人码，后期加成员分流图不变），长按识别添加 -->
        <view class="qrcode-card">
          <image class="wecom-qr" src="/assets/images/wecom-qr.png" mode="aspectFit" show-menu-by-longpress="{{true}}" />
          <text class="qrcode-tip">第二步：长按二维码添加你的私人助理，把会员码发给 TA（约 2 分钟完成连接）</text>
        </view>
      </view>

      <!-- 已开通已绑定：连接状态 + 重新连接 -->
      <view class="section" wx:if="{{!loading && status === 'active' && hasWecomBound}}">
        <view class="section-title">私人助理</view>
        <view class="qrcode-card">
          <text class="bound-text">已连接私人助理 ✅</text>
          <text class="qrcode-tip" wx:if="{{wecomBoundAtText}}">连接时间 {{wecomBoundAtText}}</text>
        </view>
        <view class="qrcode-card">
          <view class="vip-btn rebind-btn {{unbindConfirming ? 'confirming' : ''}}" bindtap="onUnbind">{{unbindConfirming ? '再点一次确认断开' : '重新连接'}}</view>
          <text class="qrcode-tip">断开当前连接后可重新添加助手</text>
        </view>
      </view>

      <view class="bottom-space" style="height: calc({{safeAreaBottom}}px + 30px);"></view>
    </view>
  </scroll-view>

  <!-- 未开通/已过期：选价 + 开通按钮固定沉底（同新建记事卡 footer：文档流布局，非 fixed） -->
  <view class="member-footer" wx:if="{{!loading && status !== 'active'}}" style="padding-bottom: calc(24rpx + {{safeAreaBottom}}px);">
    <view class="footer-title">选择{{status === 'expired' ? '续费' : '开通'}}档位</view>

    <!-- 档位卡片（数据来自 config/env.js membershipPlans，hidden 档位不展示） -->
    <view class="plan-list">
      <view class="plan-card {{selectedPlan === item.plan ? 'selected' : ''}}" wx:for="{{plans}}" wx:key="plan" data-plan="{{item.plan}}" bindtap="onSelectPlan">
        <text class="plan-label">{{item.label}}</text>
        <text class="plan-price">¥{{item.price}}</text>
        <text class="plan-days">{{item.days ? item.days + ' 天' : '终身有效'}}</text>
      </view>
    </view>

    <!-- 虚拟支付：wx.login → prepareOrder → requestVirtualPayment → confirmOrder -->
    <view class="pay-area">
      <view class="vip-btn pay-btn {{paying ? 'disabled' : ''}}" bindtap="onPay">{{payBtnText}}</view>
      <!-- 人工通道降级为辅助：支付遇到问题或需人工开通时进客服会话 -->
      <button class="contact-link" open-type="contact">人工开通/支付遇到问题？联系客服</button>
    </view>
  </view>
</view>
