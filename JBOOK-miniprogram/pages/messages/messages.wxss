/* 壳不滚、内容滚：同会员页 */
.messages-page {
  padding: 0;
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
  background: #f6f7f6;
}

.messages-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 0 28rpx;
}

.messages-body {
  position: relative;
  z-index: 1;
  padding-bottom: 60rpx;
}

.messages-loading {
  padding: 80rpx 0;
  text-align: center;
}

.messages-loading-text {
  font-size: 26rpx;
  color: rgba(28, 28, 30, 0.45);
}

/* ==================== 消息条目 ==================== */

.message-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(28, 28, 30, 0.04);
}

.message-dot-wrap {
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding-top: 10rpx;
  width: 44rpx;
}

/* 未读：左侧绿点 */
.message-unread-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #00c853;
}

/* 类型色点 */
.message-type-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.message-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.message-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.message-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1c1e;
  line-height: 1.3;
}

.message-item.unread .message-title {
  font-weight: 700;
}

.message-time {
  flex: none;
  font-size: 22rpx;
  color: rgba(28, 28, 30, 0.4);
}

.message-content {
  font-size: 26rpx;
  color: rgba(28, 28, 30, 0.6);
  line-height: 1.5;
  word-break: break-all;
}
